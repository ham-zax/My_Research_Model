{
  "schema": "MFSM-RE-OBS-1-protocol-1",
  "version": "MFSM-RE-OBS-1",
  "date": "2026-09-25",
  "status": "frozen_before_execution",
  "question": "After the named benchmark shock, which one-step responses are determined by information visible before the shock?",
  "transition": {
    "member": "MFSM-RE-1",
    "implementation": "src/mfsm_reference/economy.py",
    "function": "step",
    "rule": "Use the existing deterministic transition. Do not add a market mechanism."
  },
  "observation_map": {
    "public": {
      "name": "pre_intervention_mark",
      "function": "price(state, law)",
      "fields": ["mark"],
      "timing": "before the intervention and before step()",
      "excludes": [
        "debt",
        "dealer_inventory",
        "benchmark_value",
        "account_balances",
        "forced_sale",
        "post_intervention_value"
      ]
    },
    "privileged_diagnostic": {
      "name": "headroom_enhanced",
      "classification": "privileged_diagnostic",
      "not_public_data": true,
      "added_field": "pre_intervention_headroom",
      "function": "headroom(state, law) together with price(state, law), both before the intervention",
      "monotone_rule": "Adding this reading can only remove candidates already compatible with the public mark."
    }
  },
  "intervention": {
    "name": "benchmark_100_to_98",
    "parameter": "value",
    "pre_shock_value": 100,
    "post_shock_value": 98,
    "timing": "before_one_transition",
    "role": "declared_scenario_input",
    "not_a_public_signal": true
  },
  "horizon": {
    "transitions": 1
  },
  "comparison_tolerance": 1e-9,
  "comparison_rules": {
    "mark_agreement": "absolute difference at most comparison_tolerance",
    "forced_sale_occurred": "forced-sale quantity strictly greater than comparison_tolerance",
    "disagree_when": "next marks disagree or forced-sale occurrence disagrees",
    "evaluated_on": "candidates compatible with the observed pre-shock mark, in protocol order",
    "witness": "first protocol-order pair among compatible candidates whose one-step responses disagree"
  },
  "status_vocabulary": {
    "compatible_responses_disagree": "not_identified",
    "compatible_responses_agree": "invariant_within_declared_candidates",
    "no_compatible_candidate": "incompatible_observation",
    "forbidden": ["globally_identified", "confidence_interval", "probability"]
  },
